---
/**
 * Jalaku — Halaman Katalog Produk
 *
 * SSR: fetch GET /products di frontmatter.
 * Filter kategori via query string (?kategori=beras).
 * Responsive grid: 1-col → 2-col → 3-col → 4-col.
 */
import CustomerLayout from '../../layouts/CustomerLayout.astro';
import ProductCard from '../../components/customer/ProductCard.astro';

// SSR fetch — menggunakan URL absolut dari env
const PRODUCT_URL = import.meta.env.PUBLIC_PRODUCT_SERVICE_URL || 'http://localhost:3002';

// Baca query params
const page = Number(Astro.url.searchParams.get('page')) || 1;
const kategori = Astro.url.searchParams.get('kategori') || '';
const limit = 12;

// Build API URL
const params = new URLSearchParams();
params.set('page', String(page));
params.set('limit', String(limit));
if (kategori) params.set('kategori', kategori);

// Fetch produk
let products: any[] = [];
let meta = { total_items: 0, current_page: 1, total_pages: 1 };

try {
  const res = await fetch(`${PRODUCT_URL}/products?${params.toString()}`);
  if (res.ok) {
    const json = await res.json();
    products = json.data || [];
    meta = json.meta || meta;
  }
} catch {
  // Fallback — produk kosong
}

const KATEGORI_OPTIONS = [
  { value: '', label: 'Semua' },
  { value: 'gabah', label: 'Gabah' },
  { value: 'beras', label: 'Beras' },
  { value: 'kopi', label: 'Kopi' },
  { value: 'alpukat', label: 'Alpukat' },
  { value: 'jagung', label: 'Jagung' },
  { value: 'olahan_dapur', label: 'Olahan Dapur' },
];
---

<CustomerLayout title="Katalog Produk" activeMenu="katalog">

  <!-- Hero Banner -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-dark via-primary to-primary-light">
    <div class="absolute inset-0 opacity-10">
      <svg class="w-full h-full" viewBox="0 0 400 200" fill="none">
        <circle cx="350" cy="30" r="120" fill="white" opacity="0.1" />
        <circle cx="50" cy="180" r="80" fill="white" opacity="0.05" />
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight" style="font-family: Outfit, sans-serif;">
        Katalog Produk 🌾
      </h1>
      <p class="text-sm sm:text-base text-white/70 mt-2 max-w-lg">
        Pilihan hasil tani, kebun, dan olahan dapur segar langsung dari desa kami.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Filter Chips -->
    <div class="flex flex-wrap gap-2 mb-8">
      {KATEGORI_OPTIONS.map(opt => (
        <a
          href={opt.value ? `/produk?kategori=${opt.value}` : '/produk'}
          class:list={[
            'px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 border',
            kategori === opt.value
              ? 'bg-primary text-white border-primary shadow-md shadow-primary/20'
              : 'bg-white text-text-light border-gray-200 hover:border-primary/30 hover:text-primary hover:bg-primary/5'
          ]}
        >
          {opt.label}
        </a>
      ))}
    </div>

    <!-- Product Grid -->
    {products.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {products.map((product: any) => (
          <ProductCard {...product} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
        <h3 class="text-lg font-bold text-text" style="font-family: Outfit, sans-serif;">
          Produk belum tersedia
        </h3>
        <p class="text-sm text-text-muted mt-1">
          {kategori ? 'Tidak ada produk untuk kategori ini.' : 'Belum ada produk yang ditambahkan.'}
        </p>
        {kategori && (
          <a href="/produk" class="inline-flex items-center gap-1 mt-4 text-sm font-medium text-primary hover:underline">
            ← Lihat semua produk
          </a>
        )}
      </div>
    )}

    <!-- Pagination -->
    {meta.total_pages > 1 && (
      <div class="flex items-center justify-center gap-2 mt-10">
        {page > 1 && (
          <a
            href={`/produk?page=${page - 1}${kategori ? `&kategori=${kategori}` : ''}`}
            class="px-4 py-2 rounded-xl text-sm font-medium border border-gray-200 text-text-light hover:bg-gray-50 transition-colors"
          >
            ← Sebelumnya
          </a>
        )}

        <span class="px-4 py-2 text-sm text-text-muted">
          Halaman {meta.current_page} dari {meta.total_pages}
        </span>

        {page < meta.total_pages && (
          <a
            href={`/produk?page=${page + 1}${kategori ? `&kategori=${kategori}` : ''}`}
            class="px-4 py-2 rounded-xl text-sm font-medium border border-gray-200 text-text-light hover:bg-gray-50 transition-colors"
          >
            Berikutnya →
          </a>
        )}
      </div>
    )}

  </div>
</CustomerLayout>
