---
/**
 * Jalaku — Halaman Checkout
 *
 * Menampilkan CartManager (React Island) yang menangani
 * keranjang belanja dan form checkout guest.
 */
import CustomerLayout from '../layouts/CustomerLayout.astro';
import CartManager from '../components/customer/CartManager.tsx';
---

<CustomerLayout title="Keranjang & Checkout">

  <!-- Mini Hero -->
  <section class="bg-gradient-to-r from-primary-dark to-primary py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight" style="font-family: Outfit, sans-serif;">
        Keranjang & Checkout 🛒
      </h1>
      <p class="text-sm text-white/60 mt-1">
        Periksa pesanan Anda dan selesaikan pembelian.
      </p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <CartManager client:load />
  </div>

</CustomerLayout>
