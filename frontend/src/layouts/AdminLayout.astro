---
import BaseLayout from './BaseLayout.astro';
import AdminTopbar from '../components/admin/AdminTopbar.tsx';

interface Props {
  title: string;
  activeMenu?: string;
}

const { title, activeMenu } = Astro.props;

const navItems = [
  {
    href: '/admin',
    label: 'Dashboard',
    key: 'dashboard',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    href: '/admin/produk',
    label: 'Produk',
    key: 'produk',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    href: '/admin/pesanan',
    label: 'Pesanan',
    key: 'pesanan',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  },
  {
    href: '/admin/booking',
    label: 'Booking',
    key: 'booking',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
];
---

<BaseLayout title={title} description="Jalaku Admin Dashboard">
  <div id="admin-root" class="flex min-h-screen bg-surface dark:bg-gray-900 transition-colors duration-300">
    <!-- ======== Sidebar (White, Collapsible) ======== -->
    <aside
      id="admin-sidebar"
      class="sidebar-expanded flex flex-col fixed h-full z-30 -translate-x-full lg:translate-x-0 bg-white dark:bg-gray-800 border-r border-gray-200/80 dark:border-gray-700/60 shadow-sm"
      style="transition: width 300ms ease-out, transform 300ms ease-out; will-change: width, transform;"
    >
      <!-- Brand -->
      <div class="px-5 py-5 border-b border-gray-100 dark:border-gray-700/60 flex items-center justify-between">
        <a href="/admin" class="flex items-center gap-3 group sidebar-brand">
          <div class="w-10 h-10 bg-gradient-to-br from-primary to-primary-light rounded-xl flex items-center justify-center shadow-lg shadow-primary/20 group-hover:scale-105 transition-transform duration-200 shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div class="sidebar-label overflow-hidden whitespace-nowrap">
            <span class="font-heading text-xl font-bold text-gray-900 dark:text-white tracking-tight">Jalaku</span>
            <span class="block text-[11px] text-gray-400 dark:text-gray-500 font-medium -mt-0.5">Admin Panel</span>
          </div>
        </a>
        <!-- Collapse toggle (desktop only) -->
        <button
          id="btn-collapse-sidebar"
          class="hidden lg:flex p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors cursor-pointer text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300"
          title="Collapse sidebar"
        >
          <svg class="w-5 h-5 sidebar-collapse-icon transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
          </svg>
        </button>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200 group/nav",
              activeMenu === item.key
                ? "bg-primary/10 dark:bg-green-900/30 text-primary dark:text-green-400 shadow-sm"
                : "text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-100 dark:hover:bg-gray-700/50",
            ]}
            title={item.label}
          >
            <svg class:list={[
              "w-5 h-5 shrink-0 transition-colors",
              activeMenu === item.key
                ? "text-primary dark:text-green-400"
                : "text-gray-400 dark:text-gray-500 group-hover/nav:text-gray-600 dark:group-hover/nav:text-gray-300"
            ]} fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            <span class="sidebar-label overflow-hidden whitespace-nowrap">{item.label}</span>
            {activeMenu === item.key && (
              <span class="ml-auto w-1.5 h-1.5 rounded-full bg-primary dark:bg-green-400 sidebar-label" />
            )}
          </a>
        ))}
      </nav>

      <!-- Logout -->
      <div class="p-3 border-t border-gray-100 dark:border-gray-700/60">
        <button
          id="btn-logout"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-gray-400 dark:text-gray-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-all duration-200 w-full cursor-pointer"
          title="Keluar"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="sidebar-label overflow-hidden whitespace-nowrap">Keluar</span>
        </button>
      </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-20 lg:hidden hidden backdrop-blur-sm transition-opacity duration-300"></div>

    <!-- ======== Main Content ======== -->
    <main id="admin-main" class="flex-1 lg:ml-64 min-h-screen" style="transition: margin-left 300ms ease-out;">
      <!-- Top bar -->
      <header class="sticky top-0 z-10 border-b border-gray-200/60 dark:border-gray-700/60 px-4 sm:px-6 py-3 flex items-center justify-between bg-white/85 dark:bg-gray-800/85 backdrop-blur-xl">
        <div class="flex items-center gap-3">
          <!-- Mobile/Collapse hamburger toggle -->
          <button id="btn-toggle-sidebar" class="p-2 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-700/50 transition-colors cursor-pointer">
            <svg class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 class="font-heading text-lg sm:text-xl font-bold text-gray-900 dark:text-white">{title}</h1>
        </div>

        <!-- Topbar interactive features (React Island: theme toggle, notifications, profile) -->
        <AdminTopbar client:load />
      </header>

      <!-- Page content -->
      <div class="p-4 sm:p-6 lg:p-8">
        <slot />
      </div>
    </main>
  </div>

  <style>
    /* Sidebar width states */
    .sidebar-expanded {
      width: 16rem; /* 256px = w-64 */
    }
    .sidebar-collapsed {
      width: 4.5rem; /* 72px — icon-only */
    }

    /* Hide text labels when collapsed */
    .sidebar-collapsed .sidebar-label {
      width: 0;
      opacity: 0;
      overflow: hidden;
    }

    /* Rotate collapse icon when collapsed */
    .sidebar-collapsed .sidebar-collapse-icon {
      transform: rotate(180deg);
    }

    /* Center brand icon when collapsed */
    .sidebar-collapsed .sidebar-brand {
      justify-content: center;
    }

    /* Center nav items when collapsed */
    .sidebar-collapsed nav a {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
    }

    /* Center logout when collapsed */
    .sidebar-collapsed #btn-logout {
      justify-content: center;
      padding-left: 0;
      padding-right: 0;
    }

    /* Adjust brand padding when collapsed */
    .sidebar-collapsed > div:first-child {
      justify-content: center;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    /* Hide collapse button when collapsed (use hamburger to expand) */
    .sidebar-collapsed #btn-collapse-sidebar {
      display: none;
    }
  </style>

  <script is:inline>
    // Prevent FOUC: apply dark class to #admin-root before React hydrates
    (function() {
      var el = document.getElementById('admin-root');
      if (el) {
        var t = localStorage.getItem('jalaku_theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          el.classList.add('dark');
        }
      }
    })();
  </script>

  <script>
    // ---- Sidebar Toggle (Mobile + Collapse) ----
    const sidebar = document.getElementById("admin-sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const toggleBtn = document.getElementById("btn-toggle-sidebar");
    const collapseBtn = document.getElementById("btn-collapse-sidebar");
    const mainContent = document.getElementById("admin-main");

    const COLLAPSE_KEY = "jalaku_sidebar_collapsed";

    // Mobile toggle
    function toggleSidebarMobile() {
      sidebar?.classList.toggle("-translate-x-full");
      overlay?.classList.toggle("hidden");
    }

    // Desktop collapse toggle
    function toggleSidebarCollapse() {
      const isCollapsed = sidebar?.classList.contains("sidebar-collapsed");
      if (isCollapsed) {
        // Expand
        sidebar?.classList.remove("sidebar-collapsed");
        sidebar?.classList.add("sidebar-expanded");
        mainContent?.style.setProperty("margin-left", "16rem");
        localStorage.setItem(COLLAPSE_KEY, "false");
      } else {
        // Collapse
        sidebar?.classList.remove("sidebar-expanded");
        sidebar?.classList.add("sidebar-collapsed");
        mainContent?.style.setProperty("margin-left", "4.5rem");
        localStorage.setItem(COLLAPSE_KEY, "true");
      }
    }

    // Check if desktop or mobile
    function isDesktop() {
      return window.innerWidth >= 1024; // lg breakpoint
    }

    toggleBtn?.addEventListener("click", () => {
      if (isDesktop()) {
        toggleSidebarCollapse();
      } else {
        toggleSidebarMobile();
      }
    });

    collapseBtn?.addEventListener("click", toggleSidebarCollapse);
    overlay?.addEventListener("click", toggleSidebarMobile);

    // Restore collapse state on load (desktop only)
    function restoreCollapseState() {
      if (isDesktop()) {
        const wasCollapsed = localStorage.getItem(COLLAPSE_KEY) === "true";
        if (wasCollapsed) {
          sidebar?.classList.remove("sidebar-expanded");
          sidebar?.classList.add("sidebar-collapsed");
          mainContent?.style.setProperty("margin-left", "4.5rem");
        } else {
          mainContent?.style.setProperty("margin-left", "16rem");
        }
      } else {
        // Mobile: always hidden initially, remove margin
        mainContent?.style.removeProperty("margin-left");
      }
    }

    restoreCollapseState();

    // Handle resize: auto-collapse on mobile, restore on desktop
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (!isDesktop()) {
          // Mobile: hide sidebar, remove margin
          sidebar?.classList.add("-translate-x-full");
          overlay?.classList.add("hidden");
          mainContent?.style.removeProperty("margin-left");
        } else {
          // Desktop: show sidebar, restore collapse state
          sidebar?.classList.remove("-translate-x-full");
          overlay?.classList.add("hidden");
          restoreCollapseState();
        }
      }, 100);
    });

    // ---- Auth Guard ----
    const token = localStorage.getItem("jalaku_token");
    if (!token && !window.location.pathname.includes("/admin/login")) {
      window.location.href = "/admin/login";
    }

    // ---- Logout Handler ----
    document.getElementById("btn-logout")?.addEventListener("click", () => {
      localStorage.removeItem("jalaku_token");
      localStorage.removeItem("jalaku_user");
      window.location.href = "/admin/login";
    });
  </script>
</BaseLayout>
