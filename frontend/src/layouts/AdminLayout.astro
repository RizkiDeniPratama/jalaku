---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  activeMenu?: string;
}

const { title, activeMenu } = Astro.props;

const navItems = [
  {
    href: '/admin',
    label: 'Dashboard',
    key: 'dashboard',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    href: '/admin/produk',
    label: 'Produk',
    key: 'produk',
    icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  },
  {
    href: '/admin/pesanan',
    label: 'Pesanan',
    key: 'pesanan',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  },
  {
    href: '/admin/booking',
    label: 'Booking',
    key: 'booking',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
];
---

<BaseLayout title={title} description="Jalaku Admin Dashboard">
  <div class="flex min-h-screen">
    <!-- ======== Sidebar ======== -->
    <aside
      id="admin-sidebar"
      class="w-64 flex flex-col fixed h-full z-30 transition-transform duration-300 ease-out lg:translate-x-0 -translate-x-full"
      style="background: linear-gradient(180deg, #4A2E1A 0%, #6B4226 50%, #5A3720 100%);"
    >
      <!-- Brand -->
      <div class="p-6 border-b border-white/10">
        <a href="/admin" class="flex items-center gap-3 group">
          <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform duration-200">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <div>
            <span class="font-heading text-xl font-bold text-white tracking-tight">Jalaku</span>
            <span class="block text-[11px] text-white/40 font-medium -mt-0.5">Admin Panel</span>
          </div>
        </a>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200",
              activeMenu === item.key
                ? "bg-primary text-white shadow-lg shadow-primary/30"
                : "text-white/60 hover:text-white hover:bg-white/8",
            ]}
          >
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
            </svg>
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Logout -->
      <div class="p-4 border-t border-white/10">
        <button
          id="btn-logout"
          class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-white/50 hover:text-danger-light hover:bg-danger/10 transition-all duration-200 w-full cursor-pointer"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Keluar
        </button>
      </div>
    </aside>

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-20 lg:hidden hidden backdrop-blur-sm transition-opacity duration-300"></div>

    <!-- ======== Main Content ======== -->
    <main class="flex-1 lg:ml-64 min-h-screen">
      <!-- Top bar -->
      <header class="sticky top-0 z-10 border-b border-gray-200/60 px-6 py-4 flex items-center justify-between glass-light">
        <div class="flex items-center gap-4">
          <!-- Mobile hamburger -->
          <button id="btn-toggle-sidebar" class="lg:hidden p-2 rounded-xl hover:bg-gray-100 transition-colors cursor-pointer">
            <svg class="w-6 h-6 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>

          <h1 class="font-heading text-xl font-bold text-text">{title}</h1>
        </div>

        <!-- User info -->
        <div id="admin-user-info" class="flex items-center gap-3">
          <div class="w-9 h-9 bg-primary/10 rounded-full flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        </div>
      </header>

      <!-- Page content -->
      <div class="p-6 lg:p-8">
        <slot />
      </div>
    </main>
  </div>

  <script>
    // ---- Sidebar Toggle (Mobile) ----
    const sidebar = document.getElementById("admin-sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const toggleBtn = document.getElementById("btn-toggle-sidebar");

    function toggleSidebar() {
      sidebar?.classList.toggle("-translate-x-full");
      overlay?.classList.toggle("hidden");
    }

    toggleBtn?.addEventListener("click", toggleSidebar);
    overlay?.addEventListener("click", toggleSidebar);

    // ---- Auth Guard ----
    const token = localStorage.getItem("jalaku_token");
    if (!token && !window.location.pathname.includes("/admin/login")) {
      window.location.href = "/admin/login";
    }

    // ---- Logout Handler ----
    document.getElementById("btn-logout")?.addEventListener("click", () => {
      localStorage.removeItem("jalaku_token");
      localStorage.removeItem("jalaku_user");
      window.location.href = "/admin/login";
    });

    // ---- Display User Info ----
    const userRaw = localStorage.getItem("jalaku_user");
    if (userRaw) {
      try {
        const user = JSON.parse(userRaw);
        const infoEl = document.getElementById("admin-user-info");
        if (infoEl) {
          const emailSpan = document.createElement("span");
          emailSpan.className = "text-sm font-medium text-text hidden sm:block";
          emailSpan.textContent = user.email;
          infoEl.insertBefore(emailSpan, infoEl.firstChild);
        }
      } catch {
        // Ignore parse errors
      }
    }
  </script>
</BaseLayout>
