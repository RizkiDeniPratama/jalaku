---
/**
 * Jalaku — Footer Publik
 *
 * Footer customer-facing dengan tema hijau tua, layout 4 kolom.
 * Logo, Menu Utama, Bantuan, Hubungi Kami (WhatsApp).
 */
const WA_NUMBER = '6281234567890';
const WA_MESSAGE = encodeURIComponent('Halo Jalaku! Saya ingin bertanya tentang produk.');
const waLink = `https://wa.me/${WA_NUMBER}?text=${WA_MESSAGE}`;
---

<footer class="bg-primary text-white border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Tentang -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined fill text-sage text-3xl">potted_plant</span>
          <span class="font-heading text-2xl font-bold text-sage">Jalaku</span>
        </div>
        <p class="text-white/60 text-sm leading-relaxed max-w-xs">
          Membawa hasil bumi terbaik Nusantara langsung ke meja makan keluarga Anda dengan cinta dan integritas.
        </p>
      </div>

      <!-- Menu Utama -->
      <div>
        <h4 class="font-heading text-lg text-sage mb-4 font-semibold">Menu Utama</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="/produk" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Katalog Produk
            </a>
          </li>
          <li>
            <a href="/lacak" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Cek Status Pesanan
            </a>
          </li>
          <li>
            <a href="/checkout" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Keranjang
            </a>
          </li>
        </ul>
      </div>

      <!-- Bantuan -->
      <div>
        <h4 class="font-heading text-lg text-sage mb-4 font-semibold">Bantuan</h4>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="#" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Kebijakan Privasi
            </a>
          </li>
          <li>
            <a href="#" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Syarat &amp; Ketentuan
            </a>
          </li>
          <li>
            <a href="#" class="text-white/60 hover:text-white transition-colors inline-flex items-center gap-2 group">
              <svg class="w-4 h-4 text-white/30 group-hover:text-sage transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              FAQs
            </a>
          </li>
        </ul>
      </div>

      <!-- Hubungi Kami -->
      <div>
        <h4 class="font-heading text-lg text-sage mb-4 font-semibold">Hubungi Kami</h4>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white text-primary font-bold px-4 py-3 rounded-xl flex items-center gap-2 hover:bg-sage transition-all w-full justify-center shadow-lg group"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Chat via WhatsApp
        </a>
        <div class="flex gap-3 mt-6 justify-center md:justify-start">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-all"
            aria-label="WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
          <a
            href="mailto:info@jalaku.id"
            class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-all"
            aria-label="Email"
          >
            <span class="material-symbols-outlined text-sm">mail</span>
          </a>
        </div>
        <p class="text-white/40 text-xs mt-4">Jam Operasional: 08:00 - 17:00 WIB</p>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-xs">
        © 2026 Jalaku Indonesian Farm-Fresh. All rights reserved.
      </p>
      <p class="text-white/50 text-xs">
        Bangga hasil bumi lokal 💚
      </p>
    </div>
  </div>
</footer>
